{
  "name": "politty-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for politty: @politty/core (private), @politty/zod, and the politty compatibility alias",
  "license": "MIT",
  "author": "toiroakr",
  "repository": {
    "type": "git",
    "url": "https://github.com/toiroakr/politty.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @politty/zod build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo --incremental",
    "lint": "oxlint -c oxlint.json packages tests",
    "lint:fix": "oxlint -c oxlint.json --fix packages tests",
    "knip": "knip",
    "format": "oxfmt packages tests",
    "format:check": "oxfmt --check packages tests",
    "organize-imports": "organize-imports-cli tsconfig.json",
    "fix:oxlint": "oxlint -c oxlint.json --fix",
    "fix:oxfmt": "oxfmt",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@quansync/fs": "^1.0.0",
    "@types/node": "^25.9.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "organize-imports-cli": "^1.0.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "quansync": "^1.0.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.12.0 <21.0.0 || >=21.7.0"
  },
  "packageManager": "pnpm@11.20.0"
}
