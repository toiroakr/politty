{
  "name": "politty-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for politty: @politty/core (private), @politty/zod, and the politty compatibility alias",
  "license": "MIT",
  "author": "toiroakr",
  "repository": {
    "type": "git",
    "url": "https://github.com/toiroakr/politty.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @politty/zod build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm build && tsx tests/performance/run.ts",
    "typecheck": "tsgo --incremental",
    "lint": "oxlint -c oxlint.json packages tests",
    "lint:fix": "oxlint -c oxlint.json --fix packages tests",
    "knip": "knip",
    "format": "oxfmt packages tests",
    "format:check": "oxfmt --check packages tests",
    "organize-imports": "organize-imports-cli tsconfig.json",
    "fix:oxlint": "oxlint -c oxlint.json --fix",
    "fix:oxfmt": "oxfmt",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@loculus/rolldown": "0.3.0",
    "@quansync/fs": "1.1.0",
    "@types/node": "25.9.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.4",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "organize-imports-cli": "1.0.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "quansync": "1.0.0",
    "rolldown": "1.2.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20.12.0 <21.0.0 || >=21.7.0"
  },
  "packageManager": "pnpm@12.13.0"
}
