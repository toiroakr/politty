{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":dependencyDashboard",
    "github>aquaproj/aqua-renovate-config#2.13.0",
    "github>toiroakr/karinto:pin#v0.12.0"
  ],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["271965483+toiroakr-release-bot[bot]@users.noreply.github.com"],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "internalChecksAsSuccess": true,
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["pnpm dlx pkg-pr-new@(?<currentValue>\\S+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pkg-pr-new"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "rangeStrategy": "pin"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "groupName": "loculus",
      "matchPackageNames": ["loculus", "@loculus/rolldown"],
      "separateMajorMinor": false
    },
    {
      "groupName": "testing",
      "minimumGroupSize": 2,
      "matchPackageNames": ["vitest", "@vitest/*"]
    },
    {
      "groupName": "linting and formatting",
      "matchPackageNames": ["oxlint", "oxfmt", "knip"]
    },
    {
      "groupName": "typescript",
      "matchPackageNames": ["typescript", "@types/*", "@typescript/*"]
    },
    {
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchFileNames": ["packages/loculus/package.json"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "minimumGroupSize": 1
  }
}
